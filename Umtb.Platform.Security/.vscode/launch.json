{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Security Sample (.NET 10)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Security Sample (.NET 10)",
      "program": "${workspaceFolder}/samples/Umtb.Platform.Security.Sample/bin/Debug/net10.0/Umtb.Platform.Security.Sample.dll",
      "cwd": "${workspaceFolder}/samples/Umtb.Platform.Security.Sample",
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ]
}
